# ===================================
# قاعدة البيانات (نفس اللعبة)
# ===================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/mgara?retryWrites=true&w=majority

# ===================================
# فيسبوك ماسنجر - صفحة الاقتصاد
# ===================================
PAGE_ACCESS_TOKEN=your_economy_page_token
VERIFY_TOKEN=mgara_economy_verify_token

# ===================================
# تلغرام - بوت الاقتصاد
# ===================================
TELEGRAM_BOT_TOKEN=your_economy_telegram_token

# ===================================
# المدير الرئيسي
# ===================================
ADMIN_PSID=your_facebook_psid
ADMIN_TELEGRAM_ID=your_telegram_id

# ===================================
# روابط وبيانات
# ===================================
ADMIN_PROFILE_URL=https://facebook.com/yourprofile
ADMIN_DISPLAY_NAME=الإدارة

# رابط صفحة اللعبة (للتوجيه)
GAME_PAGE_URL=https://facebook.com/MGARA-Game
GAME_TELEGRAM_BOT=@MGARA_Game_Bot

# ===================================
# إعدادات السيرفر
# ===================================
PORT=3000
